<Project>
	<Import Project="..\Directory.Build.props" />
	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<!-- The samples use the packages of artifacts/packages, as an application does once they are on NuGet. -->
		<ChromaDotNetLocalVersion>$(VersionPrefix)-$(VersionSuffix)</ChromaDotNetLocalVersion>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>
</Project>
