<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- The sample takes the packages from nuget.org, as an application does, not those built in artifacts/packages. -->
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	</packageSources>
	<packageSourceMapping>
		<clear />
	</packageSourceMapping>
</configuration>
