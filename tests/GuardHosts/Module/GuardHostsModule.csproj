<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- A binary module of PowerShell: its dependencies, the native files of the packages included, go into its own folder. -->
		<EnableDynamicLoading>true</EnableDynamicLoading>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" />
		<PackageReference Include="ChromaDotNet.Local.ChromaDB" Version="$(ChromaDotNetLocalChromaDBVersion)" />
	</ItemGroup>
</Project>
