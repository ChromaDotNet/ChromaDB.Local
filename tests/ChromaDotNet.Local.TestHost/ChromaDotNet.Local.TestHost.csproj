<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0</TargetFrameworks>
		<!-- .NET Framework, through the netstandard2.0 build of ChromaDotNet.Local, on Windows. -->
		<TargetFrameworks Condition="'$(OS)' == 'Windows_NT' And '$(LocalPackages)' == ''">net8.0;net48</TargetFrameworks>
		<!-- -p:Aot=true publishes the .NET 8 build with NativeAOT, to check that ChromaDotNet.Local works there. -->
		<PublishAot Condition="'$(Aot)' == 'true' And '$(TargetFramework)' == 'net8.0'">true</PublishAot>
	</PropertyGroup>
	<!-- The ways to reference the packages. By default the two engines, ChromaDotNet.Local.ChromaDB and ChromaDotNet.Local.VecturaDB:
	     the variable CHROMA_LOCAL_ENGINE chooses one.
	     -p:LocalPackages=chromadb: ChromaDotNet.Local.ChromaDB, with the executables of every platform.
	     -p:LocalPackages=chromadb-download: the same with ChromaDotNetLocalChromaDBDownload, which takes the executables out.
	     -p:LocalPackages=vecturadb: ChromaDotNet.Local.VecturaDB, which downloads its executable.
	     -p:LocalPackages=base: ChromaDotNet.Local alone, without an engine. -->
	<ItemGroup Condition="'$(LocalPackages)' == '' Or '$(LocalPackages)' == 'chromadb' Or '$(LocalPackages)' == 'chromadb-download'">
		<PackageReference Include="ChromaDotNet.Local.ChromaDB" Version="$(ChromaDotNetLocalChromaDBVersion)" />
	</ItemGroup>
	<ItemGroup Condition="'$(LocalPackages)' == '' Or '$(LocalPackages)' == 'vecturadb'">
		<PackageReference Include="ChromaDotNet.Local.VecturaDB" Version="$(ChromaDotNetLocalVecturaDBVersion)" />
	</ItemGroup>
	<ItemGroup Condition="'$(LocalPackages)' == 'base'">
		<PackageReference Include="ChromaDotNet.Local" Version="$(ChromaDotNetLocalVersion)" />
	</ItemGroup>
	<PropertyGroup Condition="'$(LocalPackages)' == 'chromadb-download'">
		<ChromaDotNetLocalChromaDBDownload>true</ChromaDotNetLocalChromaDBDownload>
	</PropertyGroup>
</Project>
