<Project>
	<!-- A runtime package: the Chroma executable of one platform in runtimes/<rid>/native/, and on Linux and macOS the guard next to
	     it. No assembly. ChromaRid and ChromaSource are set by the project of each platform. -->
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<IsPackable>true</IsPackable>
		<PackageId>ChromaDotNet.Local.Runtime.$(ChromaRid)</PackageId>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!-- NU5128: no lib folder, on purpose. -->
		<NoWarn>$(NoWarn);NU5128</NoWarn>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageDescription>The Chroma $(ChromaVersion) executable for $(ChromaRid), for ChromaDotNet.Local: $(ChromaSourceDescription) Chroma is under the Apache License 2.0; the notices of its dependencies are in THIRD-PARTY-NOTICES.md. Community project, not affiliated with Chroma.</PackageDescription>
		<ChromaExe Condition="'$(ChromaRid)' == 'win-x64'">chroma.exe</ChromaExe>
		<ChromaExe Condition="'$(ChromaRid)' != 'win-x64'">chroma</ChromaExe>
		<ChromaBinaries>$(MSBuildThisFileDirectory)..\..\artifacts\$(ChromaSource)\$(ChromaRid)\</ChromaBinaries>
		<ChromaGuard>$(MSBuildThisFileDirectory)..\..\artifacts\guard\$(ChromaRid)\chroma-local-guard</ChromaGuard>
		<ChromaGuard Condition="'$(ChromaSource)' == 'linux'">$(ChromaBinaries)chroma-local-guard</ChromaGuard>
	</PropertyGroup>
	<ItemGroup>
		<None Include="$(ChromaBinaries)$(ChromaExe)" Condition="Exists('$(ChromaBinaries)$(ChromaExe)')" Pack="true" PackagePath="runtimes\$(ChromaRid)\native\" Visible="false" />
		<None Include="$(ChromaGuard)" Pack="true" PackagePath="runtimes\$(ChromaRid)\native\" Visible="false" Condition="'$(ChromaRid)' != 'win-x64' And Exists('$(ChromaGuard)')" />
		<None Include="$(ChromaBinaries)BUILD-INFO.txt" Condition="Exists('$(ChromaBinaries)BUILD-INFO.txt')" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
	<!-- .NET Framework does not copy runtimes/<rid>/native/ to the output: the targets of the package do it. -->
	<ItemGroup Condition="'$(ChromaRid)' == 'win-x64'">
		<None Include="$(MSBuildProjectDirectory)\ChromaDotNet.Local.Runtime.win-x64.targets" Pack="true" PackagePath="buildTransitive\" Visible="false" />
	</ItemGroup>
	<!-- -p:AllowMissingBinaries=true packs a runtime package without its executable, only to try the other packages locally. -->
	<Target Name="CheckChromaBinaries" BeforeTargets="GenerateNuspec" Condition="'$(AllowMissingBinaries)' != 'true'">
		<Error Condition="!Exists('$(ChromaBinaries)$(ChromaExe)')" Text="Missing $(ChromaBinaries)$(ChromaExe): run build/fetch-official.sh or build/build-linux-docker.sh." />
		<Error Condition="'$(ChromaRid)' != 'win-x64' And !Exists('$(ChromaGuard)')" Text="Missing $(ChromaGuard): run the build of the guard." />
	</Target>
</Project>
