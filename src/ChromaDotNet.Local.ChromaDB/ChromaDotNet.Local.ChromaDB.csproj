<Project Sdk="Microsoft.NET.Sdk">
	<!-- The engine Chroma: an assembly with no code, whose AssemblyMetadata describe the engine to the base (EnginePackage), and a
	     dependency on the base and on the runtime package of each platform, as Microsoft.ML.OnnxRuntime and the bundles of SQLitePCLRaw
	     do. build/pack.sh packs the base and the runtime packages first, into artifacts/packages. -->
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<IsPackable>true</IsPackable>
		<PackageId>ChromaDotNet.Local.ChromaDB</PackageId>
		<Version>$(ChromaDBVersion)</Version>
		<RootNamespace>ChromaDotNet.Local.ChromaDB</RootNamespace>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageDescription>Chroma $(ChromaVersion) for ChromaDotNet.Local: ChromaLocalServer.StartAsync starts the executable of the Chroma CLI as a child process on 127.0.0.1, for ChromaDotNet.Client, and stops it with Dispose or when the application ends. With the executables for Windows x64, Linux x64 and arm64 (glibc 2.28 and later), macOS x64 and arm64, in its runtime packages; with the property ChromaDotNetLocalChromaDBDownload set to true in the project, the first start downloads the one of its platform instead. Community project, not affiliated with Chroma.</PackageDescription>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="ChromaDotNet.Local" Version="[$(LocalVersion), 2.0.0)" PrivateAssets="none" />
		<PackageReference Include="ChromaDotNet.Local.ChromaDB.Runtime.win-x64" Version="[$(Version)]" PrivateAssets="none" />
		<PackageReference Include="ChromaDotNet.Local.ChromaDB.Runtime.linux-x64" Version="[$(Version)]" PrivateAssets="none" />
		<PackageReference Include="ChromaDotNet.Local.ChromaDB.Runtime.linux-arm64" Version="[$(Version)]" PrivateAssets="none" />
		<PackageReference Include="ChromaDotNet.Local.ChromaDB.Runtime.osx-x64" Version="[$(Version)]" PrivateAssets="none" />
		<PackageReference Include="ChromaDotNet.Local.ChromaDB.Runtime.osx-arm64" Version="[$(Version)]" PrivateAssets="none" />
		<None Update="buildTransitive\ChromaDotNet.Local.ChromaDB.targets" Pack="true" PackagePath="buildTransitive/ChromaDotNet.Local.ChromaDB.targets" />
	</ItemGroup>
	<!-- The description of the engine for the base: keys with the prefix ChromaDotNet.Local., read by EnginePackage of the base. -->
	<ItemGroup>
		<AssemblyMetadata Include="ChromaDotNet.Local.Engine" Value="ChromaDB" />
		<AssemblyMetadata Include="ChromaDotNet.Local.EngineVersion" Value="$(ChromaVersion)" />
		<AssemblyMetadata Include="ChromaDotNet.Local.ReleaseUri" Value="https://github.com/ChromaDotNet/ChromaDB.Local/releases/download/chromadb-v$(Version)/" />
		<AssemblyMetadata Include="ChromaDotNet.Local.CacheName" Value="chromadb-v$(Version)" />
		<!-- On Windows the index of Chroma opens its files without the support of long paths, so with at most 259 characters. The
		     longest of them is <collection id>\data_level0.bin, 53 characters after the data path: with a longer data path Chroma
		     starts, and does not load the index of a collection at the next start. -->
		<AssemblyMetadata Include="ChromaDotNet.Local.MaxWindowsDataPathLength" Value="206" />
	</ItemGroup>
	<!-- The executables of the runtime packages, from artifacts/stage/chromadb/, where build/stage.sh puts them. Their SHA-256 hashes
	     go into the assembly, for the download and for the copy into the cache of a user who cannot execute the file of the package.
	     The release has each of them compressed with gzip, as build/release-assets.sh writes them. -->
	<PropertyGroup>
		<ChromaDBStage>$(MSBuildThisFileDirectory)..\..\artifacts\stage\chromadb\</ChromaDBStage>
	</PropertyGroup>
	<ItemGroup>
		<ChromaDBExecutable Include="$(ChromaDBStage)win-x64\chromadb.exe" Rid="win-x64" ExecutableName="chromadb.exe" Asset="chromadb-win-x64.exe.gz" />
		<ChromaDBExecutable Include="$(ChromaDBStage)linux-x64\chromadb" Rid="linux-x64" ExecutableName="chromadb" Asset="chromadb-linux-x64.gz" />
		<ChromaDBExecutable Include="$(ChromaDBStage)linux-arm64\chromadb" Rid="linux-arm64" ExecutableName="chromadb" Asset="chromadb-linux-arm64.gz" />
		<ChromaDBExecutable Include="$(ChromaDBStage)osx-x64\chromadb" Rid="osx-x64" ExecutableName="chromadb" Asset="chromadb-osx-x64.gz" />
		<ChromaDBExecutable Include="$(ChromaDBStage)osx-arm64\chromadb" Rid="osx-arm64" ExecutableName="chromadb" Asset="chromadb-osx-arm64.gz" />
	</ItemGroup>
	<Target Name="AddChromaDBExecutables" BeforeTargets="GetAssemblyAttributes">
		<ItemGroup>
			<_ChromaDBFound Include="@(ChromaDBExecutable)" Condition="Exists('%(FullPath)')" />
			<_ChromaDBMissing Include="@(ChromaDBExecutable)" Condition="!Exists('%(FullPath)')" />
		</ItemGroup>
		<Error Condition="'$(RequireExecutableHashes)' == 'true' And '@(_ChromaDBMissing)' != ''" Text="No executable for the hash: @(_ChromaDBMissing). Run build/stage.sh." />
		<GetFileHash Files="@(_ChromaDBFound)" Algorithm="SHA256" HashEncoding="hex" Condition="'@(_ChromaDBFound)' != ''">
			<Output TaskParameter="Items" ItemName="_ChromaDBHashed" />
		</GetFileHash>
		<ItemGroup>
			<AssemblyMetadata Include="ChromaDotNet.Local.Executable:%(_ChromaDBHashed.Rid)" Value="%(_ChromaDBHashed.ExecutableName)" />
			<AssemblyMetadata Include="ChromaDotNet.Local.Asset:%(_ChromaDBHashed.Rid)" Value="%(_ChromaDBHashed.Asset)" />
			<AssemblyMetadata Include="ChromaDotNet.Local.Sha256:%(_ChromaDBHashed.Rid)" Value="%(_ChromaDBHashed.FileHash)" />
		</ItemGroup>
	</Target>
</Project>
