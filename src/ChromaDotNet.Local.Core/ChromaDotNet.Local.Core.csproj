<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<IsPackable>true</IsPackable>
		<!-- The analyzers of trimming and NativeAOT run on the target that has them. -->
		<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
		<PackageId>ChromaDotNet.Local.Core</PackageId>
		<!-- The assembly and the namespace are those of ChromaDotNet.Local, the package most applications reference. -->
		<AssemblyName>ChromaDotNet.Local</AssemblyName>
		<RootNamespace>ChromaDotNet.Local</RootNamespace>
		<PackageDescription>The code of ChromaDotNet.Local, without the Chroma executables: add the ChromaDotNet.Local.Runtime package of each platform the application runs on, or reference ChromaDotNet.Local, which brings them all. ChromaLocalServer.StartAsync starts Chroma $(ChromaVersion) as a child process on 127.0.0.1, for ChromaDotNet.Client, and stops it with Dispose or when the application ends. Community project, not affiliated with Chroma.</PackageDescription>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- RS0026 and RS0027: overloads with optional parameters, as in the client. -->
		<NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<AssemblyMetadata Include="ChromaVersion" Value="$(ChromaVersion)" />
		<AssemblyMetadata Include="ChromaCliTag" Value="$(ChromaCliTag)" />
		<!-- The GitHub release with the executables of this version, for the download when there is no runtime package. -->
		<AssemblyMetadata Include="ReleaseTag" Value="v$(Version)" />
		<InternalsVisibleTo Include="ChromaDotNet.Local.Tests" />
	</ItemGroup>
	<ItemGroup>
		<!-- The public API, checked at build, as in the client. -->
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
		<PackageReference Include="ChromaDotNet.Client" Version="2.14.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
	</ItemGroup>
	<!-- The SHA-256 hash of each executable of the runtime packages, from the same files, as AssemblyMetadata
	     ChromaExecutable:<rid>:<name>: the download checks the files of the release against them. A file that is not there has no hash,
	     and its platform cannot download; -p:RequireExecutableHashes=true, as build/pack.sh passes, makes that an error. -->
	<PropertyGroup>
		<ChromaArtifacts>$(MSBuildThisFileDirectory)..\..\artifacts\</ChromaArtifacts>
	</PropertyGroup>
	<ItemGroup>
		<ChromaExecutableFile Include="$(ChromaArtifacts)chroma-cli\win-x64\chroma.exe" Rid="win-x64" ExecutableName="chroma.exe" />
		<ChromaExecutableFile Include="$(ChromaArtifacts)chroma-cli\osx-arm64\chroma" Rid="osx-arm64" ExecutableName="chroma" />
		<ChromaExecutableFile Include="$(ChromaArtifacts)guard\osx-arm64\chroma-local-guard" Rid="osx-arm64" ExecutableName="chroma-local-guard" />
		<ChromaExecutableFile Include="$(ChromaArtifacts)chroma-cli\osx-x64\chroma" Rid="osx-x64" ExecutableName="chroma" />
		<ChromaExecutableFile Include="$(ChromaArtifacts)guard\osx-x64\chroma-local-guard" Rid="osx-x64" ExecutableName="chroma-local-guard" />
		<ChromaExecutableFile Include="$(ChromaArtifacts)linux\linux-x64\chroma" Rid="linux-x64" ExecutableName="chroma" />
		<ChromaExecutableFile Include="$(ChromaArtifacts)linux\linux-x64\chroma-local-guard" Rid="linux-x64" ExecutableName="chroma-local-guard" />
		<ChromaExecutableFile Include="$(ChromaArtifacts)linux\linux-arm64\chroma" Rid="linux-arm64" ExecutableName="chroma" />
		<ChromaExecutableFile Include="$(ChromaArtifacts)linux\linux-arm64\chroma-local-guard" Rid="linux-arm64" ExecutableName="chroma-local-guard" />
	</ItemGroup>
	<Target Name="AddChromaExecutableHashes" BeforeTargets="GetAssemblyAttributes">
		<ItemGroup>
			<_ChromaExecutableFound Include="@(ChromaExecutableFile)" Condition="Exists('%(FullPath)')" />
			<_ChromaExecutableMissing Include="@(ChromaExecutableFile)" Condition="!Exists('%(FullPath)')" />
		</ItemGroup>
		<Error Condition="'$(RequireExecutableHashes)' == 'true' And '@(_ChromaExecutableMissing)' != ''" Text="No executable for the hash: @(_ChromaExecutableMissing)" />
		<GetFileHash Files="@(_ChromaExecutableFound)" Algorithm="SHA256" HashEncoding="hex" Condition="'@(_ChromaExecutableFound)' != ''">
			<Output TaskParameter="Items" ItemName="_ChromaExecutableHashed" />
		</GetFileHash>
		<ItemGroup>
			<AssemblyMetadata Include="ChromaExecutable:%(_ChromaExecutableHashed.Rid):%(_ChromaExecutableHashed.ExecutableName)" Value="%(_ChromaExecutableHashed.FileHash)" />
		</ItemGroup>
	</Target>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<!-- IAsyncDisposable and ValueTask come from Microsoft.Bcl.AsyncInterfaces, which ChromaDotNet.Client brings in the version of
		     each of its targets: a reference here would downgrade it on .NET Framework. -->
		<PackageReference Include="PolySharp" Version="1.14.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>
