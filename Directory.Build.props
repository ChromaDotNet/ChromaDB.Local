<Project>
	<PropertyGroup>
		<!-- Three lines of versions, one for each package of its own and the packages that follow it, each with a tag of its own. -->
		<!-- ChromaDotNet.Local, the base without an engine: tags v<version>. -->
		<LocalVersion>1.5.9.1-preview.6</LocalVersion>
		<!-- ChromaDotNet.Local.ChromaDB and its runtime packages: the version of Chroma in the executables, then the revision of these
		     packages for that version; tags chromadb-v<version>. -->
		<ChromaVersion>1.5.9</ChromaVersion>
		<ChromaCliTag>cli-1.4.4</ChromaCliTag>
		<ChromaCliCommit>11f3c7435e71024aa0a2b53710a28d3289d922d1</ChromaCliCommit>
		<ChromaDBRevision>1</ChromaDBRevision>
		<ChromaDBSuffix>preview.6</ChromaDBSuffix>
		<ChromaDBVersion>$(ChromaVersion).$(ChromaDBRevision)-$(ChromaDBSuffix)</ChromaDBVersion>
		<!-- ChromaDotNet.Local.VecturaDB: the version of VecturaDB, from the tag of its release, then the revision of the package for that
		     version, as 1.0.0-preview.2.1, or 1.0.0.1 for a stable VecturaDB; tags vecturadb-v<version>. -->
		<VecturaDBTag>v1.0.0-preview.2</VecturaDBTag>
		<VecturaDBEngineVersion>$(VecturaDBTag.TrimStart('v'))</VecturaDBEngineVersion>
		<VecturaDBRevision>1</VecturaDBRevision>
		<VecturaDBVersion>$(VecturaDBEngineVersion).$(VecturaDBRevision)</VecturaDBVersion>
		<!-- The packages of the base take its version; each engine project sets its own. -->
		<Version>$(LocalVersion)</Version>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<Authors>ChromaDotNet contributors</Authors>
		<PackageTags>chroma chromadb vector-database embedded local ai embeddings rag</PackageTags>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/ChromaDotNet/ChromaDB.Local</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ChromaDotNet/ChromaDB.Local</RepositoryUrl>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<ArtifactsPackages>$(MSBuildThisFileDirectory)artifacts\packages</ArtifactsPackages>
		<PackageOutputPath>$(ArtifactsPackages)</PackageOutputPath>
		<!-- A package cache of its own, emptied of ChromaDotNet.Local by build/pack.sh, so that a new pack of the same version is taken. -->
		<RestorePackagesPath>$(MSBuildThisFileDirectory)artifacts\nuget-cache</RestorePackagesPath>
	</PropertyGroup>
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
