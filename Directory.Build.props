<Project>
	<PropertyGroup>
		<!-- The version of Chroma in the binaries, and the revision of these packages for that version: 1.5.9.1 is the first. -->
		<ChromaVersion>1.5.9</ChromaVersion>
		<ChromaCliTag>cli-1.4.4</ChromaCliTag>
		<ChromaCliCommit>11f3c7435e71024aa0a2b53710a28d3289d922d1</ChromaCliCommit>
		<PackageRevision>1</PackageRevision>
		<VersionPrefix>$(ChromaVersion).$(PackageRevision)</VersionPrefix>
		<VersionSuffix>preview.3</VersionSuffix>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<Authors>ChromaDotNet contributors</Authors>
		<PackageTags>chroma chromadb vector-database embedded local ai embeddings rag</PackageTags>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/ChromaDotNet</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<ArtifactsPackages>$(MSBuildThisFileDirectory)artifacts\packages</ArtifactsPackages>
		<PackageOutputPath>$(ArtifactsPackages)</PackageOutputPath>
		<!-- A package cache of its own, emptied of ChromaDotNet.Local by build/pack.sh, so that a new pack of the same version is taken. -->
		<RestorePackagesPath>$(MSBuildThisFileDirectory)artifacts\nuget-cache</RestorePackagesPath>
	</PropertyGroup>
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
